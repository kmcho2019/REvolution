#! /project/cad-team/LX_Semicon/kjmin/iverilog/install/bin/vvp
:ivl_version "12.0 (stable)" "(v12_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 9;
:vpi_module "/project/cad-team/LX_Semicon/kjmin/iverilog/install/lib/ivl/system.vpi";
:vpi_module "/project/cad-team/LX_Semicon/kjmin/iverilog/install/lib/ivl/vhdl_sys.vpi";
:vpi_module "/project/cad-team/LX_Semicon/kjmin/iverilog/install/lib/ivl/vhdl_textio.vpi";
:vpi_module "/project/cad-team/LX_Semicon/kjmin/iverilog/install/lib/ivl/v2005_math.vpi";
:vpi_module "/project/cad-team/LX_Semicon/kjmin/iverilog/install/lib/ivl/va_math.vpi";
:vpi_module "/project/cad-team/LX_Semicon/kjmin/iverilog/install/lib/ivl/v2009.vpi";
S_0x25cc1c0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x25cc350 .scope module, "tb" "tb" 3 2;
 .timescale -9 -9;
v0x25e17a0_0 .var "clk", 0 0;
v0x25e1840_0 .var "d", 0 0;
v0x25e1910_0 .net "q", 7 0, v0x25e1660_0;  1 drivers
S_0x25cfd00 .scope module, "dut" "right_shifter" 3 8, 4 1 0, S_0x25cc350;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "d";
    .port_info 2 /OUTPUT 8 "q";
v0x25cfee0_0 .net "clk", 0 0, v0x25e17a0_0;  1 drivers
v0x25e15a0_0 .net "d", 0 0, v0x25e1840_0;  1 drivers
v0x25e1660_0 .var "q", 7 0;
E_0x25a6ab0 .event posedge, v0x25cfee0_0;
    .scope S_0x25cfd00;
T_0 ;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x25e1660_0, 0, 8;
    %end;
    .thread T_0;
    .scope S_0x25cfd00;
T_1 ;
    %wait E_0x25a6ab0;
    %load/vec4 v0x25e15a0_0;
    %load/vec4 v0x25e1660_0;
    %parti/s 7, 1, 2;
    %concat/vec4; draw_concat_vec4
    %assign/vec4 v0x25e1660_0, 0;
    %jmp T_1;
    .thread T_1;
    .scope S_0x25cc350;
T_2 ;
    %delay 5, 0;
    %load/vec4 v0x25e17a0_0;
    %inv;
    %store/vec4 v0x25e17a0_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x25cc350;
T_3 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x25e17a0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x25e1840_0, 0, 1;
    %delay 20, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x25e1840_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x25e1840_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x25e1840_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x25e1840_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x25e1840_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x25e1840_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x25e1840_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x25e1910_0;
    %cmpi/e 234, 0, 8;
    %jmp/0xz  T_3.0, 4;
    %vpi_call/w 3 39 "$display", "===========Your Design Passed===========" {0 0 0};
    %jmp T_3.1;
T_3.0 ;
    %vpi_call/w 3 42 "$display", "===========Failed===========" {0 0 0};
T_3.1 ;
    %vpi_call/w 3 45 "$finish" {0 0 0};
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "/project/cad-team/LX_Semicon/kmcho/EoR/bench/RTLLM/Prob030_right_shifter_test.sv";
    "/project/cad-team/LX_Semicon/kmcho/EoR/exp/gpt-4.1-mini/RTLLM/Prob030_right_shifter/Gen0/Prob030_right_shifter_initial_sample1.sv";
