TD_tb.wait_for_end_of_timestep ;
    %pushi/vec4 5, 0, 32;
T_0.0 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_0.1, 5;
    %jmp/1 T_0.1, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %load/vec4 v0x10fc700_0;
    %nor/r;
    %assign/vec4 v0x10fc700_0, 0;
    %wait E_0x10e0830;
    %jmp T_0.0;
T_0.1 ;
    %pop/vec4 1;
    %end;
    .scope S_0x10faf40;
T_1 ;
    %wait E_0x10e0380;
    %vpi_func 3 16 "$random" 32 {0 0 0};
    %pushi/vec4 16, 0, 32;
    %mod/s;
    %pad/s 4;
    %split/vec4 2;
    %assign/vec4 v0x10fb2b0_0, 0;
    %assign/vec4 v0x10fb1d0_0, 0;
    %jmp T_1;
