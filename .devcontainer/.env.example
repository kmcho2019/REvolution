# Optional vLLM compose settings.
# Copy to `.devcontainer/.env` and fill values to launch the `vllm` profile.

# Local-model mount (host path mounted read-only at /models inside container)
VLLM_MODEL_DIR=/path/to/local/models
VLLM_MODEL=/models/<model-directory>

# Common runtime knobs
VLLM_PORT=8888
VLLM_TP_SIZE=1

# Optional Hugging Face token for gated models
# HUGGING_FACE_HUB_TOKEN=hf_xxx

# Optional launch overrides
# VLLM_MAX_MODEL_LEN=32768
# VLLM_GPU_MEMORY_UTILIZATION=0.90
# VLLM_MAX_NUM_SEQS=16
# VLLM_MAX_NUM_BATCHED_TOKENS=32768
# VLLM_EXTRA_ARGS=--max-seq-len-to-capture 16384
